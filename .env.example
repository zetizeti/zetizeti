# Copy to .env and fill in.

# --- the question engine (BYOK — no server key needed) ---
# Under BYOK each user supplies their own OpenRouter key in the browser; the server holds NO LLM key.
# OpenRouter is the only provider (it gateways to Claude — Claude only, never GPT).
# Optional: override the Claude model OpenRouter is asked for (default: anthropic/claude-haiku-4.5).
#   ZETIZETI_MODEL=anthropic/claude-haiku-4.5

# --- server ---
PORT=3000
# Set to "production" to require Secure (HTTPS-only) cookies.
NODE_ENV=development

# --- Google OAuth (login) ---
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorized redirect URIs must EXACTLY match GOOGLE_REDIRECT_URI below — register both
# the dev URL and the production URL there:
#   http://localhost:3000/auth/google/callback
#   https://zetizeti.com/auth/google/callback          (or wherever it deploys)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- BYOK (24 May 2026): Google is the ONLY sign-in; every user brings their own OpenRouter API key ---
# No subsidy pool, no email allow-list — each signed-in user supplies their own key (entered in the
# browser, sent per-request, never stored server-side). The server needs NO LLM key of its own.

# --- admin (subsidy review) ---
# Operator accounts who may review in-app subsidy applications. NOT a user gate (anyone signs in with
# Google) — it only identifies who runs this instance. Comma-separated, case-insensitive. Empty = no
# admin (the review view + its API are unreachable). Granting credit itself happens at OpenRouter.
ZETIZETI_ADMIN_EMAILS=
# Declared budget (USD) shown in the admin review view as "available to grant" (minus committed caps).
# Display/planning figure only — NOT the live OpenRouter balance. Default 10. Raise as you fund the org.
ZETIZETI_SUBSIDY_BUDGET=10

# Run locally with:  npm run dev   (loads this .env via node --env-file)

# --- data ---
# Persistent user DB (accounts, sessions, quests, messages). Defaults to db/zetizeti.db.
# ZETIZETI_DB=/absolute/path/to/zetizeti.db
