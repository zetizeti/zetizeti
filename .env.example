# Copy to .env and fill in.  Run locally with:  npm run dev   (loads this .env via node --env-file)

# --- server ---
PORT=3000
# Set to "production" to require Secure (HTTPS-only) cookies. Production also disables guest sign-in.
NODE_ENV=development

# --- Google OAuth (the ONLY sign-in) ---
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorized redirect URIs must EXACTLY match GOOGLE_REDIRECT_URI below — register both
# the dev URL and the production URL there:
#   http://localhost:3000/auth/google/callback
#   https://zetizeti.com/auth/google/callback          (or wherever it deploys)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- local dev without OAuth (dev only) ---
# In development you can skip Google and "continue as guest". Ignored in production.
#   ZETIZETI_ALLOW_GUEST=1

# --- the question engine: shared operator keys (the ONLY inference path) — BIFURCATED 11 Jul 2026 ---
# zetizeti is pool-only (BYOK removed 3 Jul 2026). There are now TWO shared operator keys, one per pool
# cohort, so personal testing and the student pilot bill apart. Held in memory, never logged/sent to client.
#   OPENROUTER_API_KEY     — the PERSONAL key. Used ONLY by ZETIZETI_POOL_ALLOWLIST_PERSONAL. Own-key
#                            billing: no ₹ ceiling, no metering (its spend is on the operator's own bill).
#   OPENROUTER_API_KEY_ORG — the STUDENTS (org/pilot) key. Used ONLY by the students roster, metered
#                            against ZETIZETI_MAX_BUDGET_INR + the per-user caps below.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_ORG=
# OpenRouter model slug the gateway is asked for. Default below; NOT Claude any more.
ZETIZETI_MODEL=google/gemini-3.1-flash-lite

# --- the two pool cohorts (each closed by default — a gate MUST be set to admit anyone) ---
# PERSONAL: a small comma-separated env list. Enabled as soon as OPENROUTER_API_KEY is set (own-key,
# no ceiling). EMPTY = closed (nobody). e.g. me@prayas.in,collaborator@example.com
ZETIZETI_POOL_ALLOWLIST_PERSONAL=
# STUDENTS: the cohort roster. Either inline emails (if the value contains '@') OR a path to a markdown
# file; UNSET → the bundled pool-allowlist-students.md next to the app (edit that file to manage the
# cohort). EMPTY/absent = closed. The students tier is enabled only when OPENROUTER_API_KEY_ORG AND a
# ceiling are set.
ZETIZETI_POOL_ALLOWLIST_STUDENTS=

# --- pool caps (the brakes — apply to the STUDENTS tier only; PERSONAL is own-key, uncapped) ---
# The STUDENTS tier is ENABLED only when the ORG key AND a ceiling are set:
#   studentsEnabled = OPENROUTER_API_KEY_ORG && (ZETIZETI_MAX_BUDGET_INR > 0 || ZETIZETI_POOL_DAILY_USD > 0)
# ZETIZETI_MAX_BUDGET_INR — LIFETIME ₹ ceiling on the ORG key, the fixed-pilot hard stop.
#   12000 = the usable-credit ceiling for the student cohort (NOT the ₹13,500 requisition, which also
#   covers OpenRouter fees + card forex). Spend is metered from OpenRouter's REAL billed cost (pool_spend).
ZETIZETI_MAX_BUDGET_INR=12000
# Per-user DAILY message allowance for students (the header counter). Default 40.
ZETIZETI_POOL_USER_TURNS=40
# --- OPTIONAL extra caps ---
# ZETIZETI_USER_DAILY_INR=3        # per-user DAILY ₹ cap (on top of the turn cap)
# ZETIZETI_USER_BUDGET_INR=138     # per-user LIFETIME ₹ slice of the pool (₹12000 ÷ 87 ≈ 138) — one
#                                  #   student's hard share on the ONE shared key, no per-user keys issued.
# ZETIZETI_POOL_DAILY_USD=1        # day-wide $ ceiling. LEAVE UNSET for the cohort — a $1/day cap would
#                                  #   throttle 87 students. Only for a tiny open-to-all deployment.
# ZETIZETI_USD_INR=88              # pin the FX rate; otherwise usdInr()/refreshUsdInr() fetch open.er-api.com every 12h.

# --- admin (usage monitor) ---
# Operator accounts who may read GET /api/admin/usage (per-student turns + billed ₹ against the ceiling,
# read-only). NOT a user gate. Comma-separated, case-insensitive. Empty = the monitor is unreachable.
ZETIZETI_ADMIN_EMAILS=

# --- AI Club cohort (credit engine, app #1) — OPTIONAL, off unless all three are set ---
# The 30 AI Club (Foundation) students run on their OWN individual OpenRouter key (their ~₹5,000 credit),
# NOT the shared pool. When a signed-in email is on ZETIZETI_AICLUB_ALLOWLIST, zetizeti resolves that
# student's key from the credit engine at request time, spends against their own credit (no pool caps, no
# pool metering — their cap is OpenRouter's per-key limit), and holds the key in memory for the session
# only (never persisted, never logged — invariant #8). Leave these UNSET and every user flows through the
# pool exactly as before (the pre-engine default; nothing here blocks a pool-only deploy). Precedence:
# AI Club > personal > students (a user on more than one list is served the earliest match).
#   ZETIZETI_CREDIT_ENGINE_URL=https://credit-engine.example      # where app #1 is reachable (HTTPS)
#   ZETIZETI_CREDIT_ENGINE_TOKEN=                                 # zetizeti's tool secret (the `secret`
#                                                                 #   half of the engine's zetizeti:… entry)
#   ZETIZETI_AICLUB_ALLOWLIST=                                    # comma-separated AI Club emails
#   ZETIZETI_CREDIT_CACHE_TTL_SEC=900                             # in-memory key cache TTL (default 15 min)

# --- data ---
# Persistent user DB (accounts, sessions, quests, messages, signals, criticism chats, pool_spend).
# Defaults to db/zetizeti.db locally; the Docker image sets ZETIZETI_DB=/app/data/zetizeti.db (volume).
# ZETIZETI_DB=/absolute/path/to/zetizeti.db
